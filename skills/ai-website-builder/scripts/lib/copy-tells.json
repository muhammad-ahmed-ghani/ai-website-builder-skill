  "patterns": [
    {
      "id": "no-em-dash",
      "regex": "\\u2014|&mdash;|&#8212;",
      "flags": "g",
      "severity": "error",
      "note": "Em dash. Use a period, comma, colon or parentheses, or rewrite the sentence."
    },
    {
      "id": "no-spaced-dash",
      "regex": "\\s(?:\\u2013|&ndash;|--)\\s",
      "flags": "g",
      "severity": "error",
      "note": "Dash used as a connector. Use a period, comma, colon or parentheses. Number ranges such as 9-5 are fine."
    },
    {
      "id": "proof-trusted-by",
      "regex": "\\b(?:trusted|loved) by\\b",
      "flags": "gi",
      "severity": "error",
      "note": "Borrowed proof. Keep only if the brief gives who trusts it; otherwise cut or state what the app does."
    },
    {
      "id": "proof-award",
      "regex": "\\baward[- ]winning\\b",
      "flags": "gi",
      "severity": "error",
      "note": "An award is a claim. Name the award and year from the brief or cut it."
    },
    {
      "id": "proof-count",
      "regex": "\\b\\d[\\d,.]*\\s?[km]?\\+\\s*(?:happy\\s+)?(?:customers|clients|users|businesses|teams|companies|members|students|downloads|reviews|people|families)\\b",
      "flags": "gi",
      "severity": "error",
      "note": "Round-number audience claim. Use only a number the owner gave, exactly as given."
    },
    {
      "id": "proof-join-crowd",
      "regex": "\\bjoin\\s+(?:thousands|millions|hundreds)\\b",
      "flags": "gi",
      "severity": "error",
      "note": "Invented crowd. Cut it, or invite the person to act without a headcount."
    },
    {
      "id": "proof-ranking",
      "regex": "#1\\s+(?:rated|ranked|choice|in|for|most)\\b|\\bnumber[- ]one\\s+(?:rated|choice|in|for)\\b",
      "flags": "gi",
      "severity": "error",
      "note": "A ranking is a claim. Cite the source from the brief or cut it."
    },
    {
      "id": "proof-leading",
      "regex": "\\b(?:industry|market)[- ]leading\\b",
      "flags": "gi",
      "severity": "error",
      "note": "Unmeasurable superlative. Say what the app does that others do not, if the brief says so."
    },
    {
      "id": "proof-guarantee",
      "regex": "\\b(?:100%\\s+(?:satisfaction|guaranteed|money[- ]back)|money[- ]back guarantee|satisfaction guaranteed)\\b",
      "flags": "gi",
      "severity": "error",
      "note": "A guarantee is a policy. Use it only if the owner stated it, in their terms."
    },
    {
      "id": "proof-rating",
      "regex": "\\brated\\s+\\d(?:\\.\\d)?\\s*(?:\\/\\s*5|stars?|out of)",
      "flags": "gi",
      "severity": "error",
      "note": "A rating is a statistic. Only a real, sourced one from the brief."
    },
    {
      "id": "not-just-its",
      "regex": "\\b(?:it|this|that)(?:['\\u2019]s| is)\\s+not\\s+(?:just|only|merely|simply)\\b",
      "flags": "gi",
      "severity": "warn",
      "note": "Negate-then-assert. State the second half as a plain claim."
    },
    {
      "id": "not-only-but",
      "regex": "\\bnot\\s+(?:just|only|merely)\\b[^.!?\\n]{1,70}?\\bbut\\s+(?:also\\s+)?\\w",
      "flags": "gi",
      "severity": "warn",
      "note": "Negate-then-assert. Say what it is."
    },
    {
      "id": "its-not-x-its-y",
      "regex": "\\b(?:it|this|that)(?:['\\u2019]s| is)\\s+not\\s+(?!just\\b|only\\b|merely\\b|simply\\b)[^.!?\\n,;]{1,50}[,;]\\s*(?:it|this|that)(?:['\\u2019]s| is)\\s",
      "flags": "gi",
      "severity": "warn",
      "note": "It's not X, it's Y. Keep only if the reader really believes X."
    },
    {
      "id": "more-than-just",
      "regex": "\\bmore than just\\b",
      "flags": "gi",
      "severity": "warn",
      "note": "Staged contrast. Say what it is."
    },
    {
      "id": "no-fragment-row",
      "regex": "\\bno\\s+\\w+(?:\\s\\w+)?\\.\\s+no\\s+\\w+(?:\\s\\w+)?\\.\\s+no\\s+\\w+",
      "flags": "gi",
      "severity": "warn",
      "note": "Row of negative fragments. Merge into one sentence with a specific claim."
    },
    {
      "id": "verbless-triad",
      "regex": "^\\s*[A-Z][a-z]+\\.\\s+[A-Z][a-z]+\\.\\s+[A-Z][a-z]+\\.?\\s*$",
      "flags": "m",
      "severity": "warn",
      "note": "Three one-word sentences. Replace with one concrete line from the brief."
    },
    {
      "id": "run-up-opener",
      "regex": "^\\s*(?:let(?:['\\u2019]s| us))\\s+(?:dive|explore|break (?:it|this) down|take a look)\\b|\\bhere(?:['\\u2019]s| is) the thing\\b|\\bwithout further ado\\b|\\bhere(?:['\\u2019]s| is) what you need to know\\b",
      "flags": "gim",
      "severity": "warn",
      "note": "Announces the point instead of making it. Start at the point."
    },
    {
      "id": "whether-youre",
      "regex": "\\bwhether you(?:['\\u2019]re| are) (?:a|an|just)\\b[^.!?\\n]{1,60}\\bor (?:a|an|just)\\b",
      "flags": "gi",
      "severity": "warn",
      "note": "Audience list to sound inclusive. Name the one visitor this is for."
    },
    {
      "id": "problem-question",
      "regex": "^\\s*(?:are you )?(?:tired of|struggling with|sick of|fed up with)\\b[^?\\n]{0,80}\\?",
      "flags": "gim",
      "severity": "warn",
      "note": "Marketing question opener. Name the visitor's real situation as a statement."
    },
    {
      "id": "ready-to-transform",
      "regex": "\\bready to (?:take|transform|elevate|supercharge|unlock|level up|revolutionize)\\b",
      "flags": "gi",
      "severity": "warn",
      "note": "Hype call to action. Name the action and what the person gets."
    },
    {
      "id": "unlock-potential",
      "regex": "\\bunlock(?:s|ing)?\\s+(?:the\\s+|your\\s+|its\\s+|their\\s+|our\\s+)?(?:full\\s+)?(?:power|potential|possibilities|value|secrets|magic)\\b",
      "flags": "gi",
      "severity": "warn",
      "note": "Weightless. Say what the person can now do."
    },
    {
      "id": "leverage-verb",
      "regex": "\\bleverag(?:e|es|ing)\\s+(?:the|our|your|their|its|a|an|data|ai)\\b",
      "flags": "gi",
      "severity": "warn",
      "note": "Use 'use'."
    },
    {
      "id": "elevate-hype",
      "regex": "\\belevate\\s+(?:your|the|their|our)\\s+(?:brand|business|life|game|experience|workflow|team|style|home|space|skills|career|presence|marketing|content|app|results|standards)\\b",
      "flags": "gi",
      "severity": "warn",
      "note": "Weightless. Say what changes for the person."
    },
    {
      "id": "stacked-hedge",
      "regex": "\\b(?:could|might|may)\\s+(?:potentially|possibly|arguably)\\b",
      "flags": "gi",
      "severity": "warn",
      "note": "Stacked qualifier. Keep one hedge only if the facts need it."
    },
    {
      "id": "serves-as",
      "regex": "\\b(?:serves|stands|functions) as (?:a|an|the|our)\\b",
      "flags": "gi",
      "severity": "warn",
      "note": "Use is, are or has."
    },
    {
      "id": "multiple-bangs",
      "regex": "\\w!{2,}",
      "flags": "g",
      "severity": "warn",
      "note": "One exclamation mark per page at most."
    },
    {
      "id": "emoji-in-copy",
      "regex": "[\\u{1F300}-\\u{1FAFF}\\u{2728}\\u{26A1}\\u{2B50}]",
      "flags": "gu",
      "severity": "warn",
      "note": "Emoji or sparkle as decoration. Use a real icon or nothing."
    },
    {
      "id": "generic-cta-label",
      "regex": "^\\s*(?:get started(?: now)?|learn more|read more|click here|submit|sign up now)\\s*[.!]?\\s*$",
      "flags": "gim",
      "severity": "warn",
      "note": "Name the result: verb plus what the person gets. Applies to a whole button or link label."
    }
  ]
}
