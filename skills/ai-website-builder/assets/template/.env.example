# Names only. The platform fills these in for the preview and the published app.
# Do not put provider keys (FAL_KEY, OPENAI_API_KEY, ...) in this project.

# Base URL of the platform AI rail (the stock @fal-ai/client is pointed at it).
VITE_AI_URL=
# Platform-minted, scope-limited app key. Safe for the client bundle (see src/lib/ai.ts).
VITE_AI_APP_KEY=

# The platform form relay for this app: <platform>/f/<app id>. <Form> posts here (stored for the owner, rate limited).
VITE_FORMS_URL=

# Public origin of the published app, no trailing slash. Used for canonical URLs, OG tags and sitemap.xml.
VITE_APP_URL=

# Optional: public base path when the app is not served from the domain root, e.g. /preview/abc/
# VITE_BASE=/

# Optional dev only: port the browser should use for the HMR websocket when a proxy listens elsewhere (see vite.config.ts).
# VITE_HMR_CLIENT_PORT=443
